# =============================================================================
# Treasury Management System - Environment Variables
# Copy this file to .env and update values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://tms_user:tms_password@localhost:5432/treasury_local

# For async operations (optional)
DATABASE_URL_ASYNC=postgresql+asyncpg://tms_user:tms_password@localhost:5432/treasury_local

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Treasury Management System
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a new secret key for production!
# Command: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Password Policy
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Data Paths
# -----------------------------------------------------------------------------
EXCEL_DATA_PATH=../../data/source/Treasury_System_Database_V2_Internal.xlsx
EXTRACTED_DATA_PATH=../../data/extracted/

# -----------------------------------------------------------------------------
# External Integrations
# -----------------------------------------------------------------------------
# ThaiBMA API (for trade reporting)
THAIBMA_API_URL=https://api.thaibma.or.th
THAIBMA_API_KEY=your-thaibma-api-key
THAIBMA_ENABLED=false

# BOT API (for THOR rates, regulatory data)
BOT_API_URL=https://apigw1.bot.or.th/bot/public
BOT_API_KEY=your-bot-api-key
BOT_API_ENABLED=false

# FRED API (backup for interest rates)
FRED_API_KEY=your-fred-api-key
FRED_API_ENABLED=false

# -----------------------------------------------------------------------------
# Settlement Systems (Manual ISO20022 Message Generation)
# -----------------------------------------------------------------------------
# BAHTNET - Manual input, system generates ISO20022 pacs.008 messages
BAHTNET_MODE=manual
BAHTNET_BANK_CODE=your-bank-code
BAHTNET_OUTPUT_PATH=./output/bahtnet/

# TSD - Manual input, system generates settlement instructions
TSD_MODE=manual
TSD_PARTICIPANT_CODE=your-tsd-participant-code
TSD_OUTPUT_PATH=./output/tsd/

# -----------------------------------------------------------------------------
# Business Rules
# -----------------------------------------------------------------------------
# Settlement cycle
SETTLEMENT_CYCLE_DAYS=2
INCLUDE_HOLIDAYS=false

# Limit checking
LIMIT_WARNING_THRESHOLD=80
LIMIT_BLOCK_THRESHOLD=100

# ThaiBMA reporting
THAIBMA_REPORT_DEADLINE_MINUTES=30

# -----------------------------------------------------------------------------
# Batch Processing
# -----------------------------------------------------------------------------
# EOD batch time (HH:MM format)
EOD_BATCH_TIME=18:00
ACCRUAL_CALCULATION_TIME=17:30
POSITION_BUILD_TIME=17:45

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
# Sentry (optional - error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Structured logging
LOG_FORMAT=json
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Treasury Management System
NEXT_PUBLIC_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://tms_user:tms_password@localhost:5432/treasury_test
USE_TEST_DATA=true
