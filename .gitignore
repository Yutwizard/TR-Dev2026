.vscode/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# =============================================================================
# Operating System
# =============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# =============================================================================
# Project Specific
# =============================================================================
# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old

# Logs
logs/
*.log

# Output files (keep structure, ignore contents)
output/csv/*.csv
output/json/*.json
!output/csv/.gitkeep
!output/json/.gitkeep

# Large data files (optional - uncomment if needed)
# data/source/*.xlsx
# data/extracted/*.txt

# Database files
*.db
*.sqlite
*.sqlite3

# =============================================================================
